# Copy to .env and adjust. All variables use the INFERNA_ prefix.
# Loaded via pydantic-settings in server/inferna_server/config.py and
# worker/inferna_worker/config.py.

# --- Server ---
# Database URL: SQLite (dev default) or PostgreSQL (docker compose).
INFERNA_DATABASE_URL=sqlite+aiosqlite:///./inferna.db
# JWT signing secret. Override in production.
INFERNA_JWT_SECRET=inferna-dev-secret
# When false, every API call passes as an admin user (dev escape hatch).
INFERNA_AUTH_ENABLED=true
# Password of the seeded `admin` user (created on first startup).
INFERNA_ADMIN_PASSWORD=inferna
# Shared cluster token that workers must present to register.
INFERNA_REGISTRATION_TOKEN=inferna-registration-token
# gRPC port for the worker registration/sync service.
INFERNA_GRPC_PORT=9091
# Comma-separated CORS allowed origins.
INFERNA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Host port pool allocated to model instances (per worker).
INFERNA_INSTANCE_PORT_RANGE_START=8010
INFERNA_INSTANCE_PORT_RANGE_END=8100
INFERNA_LOG_LEVEL=info

# --- Worker ---
# Control-plane gRPC endpoint (host:port).
INFERNA_SERVER_URL=localhost:9091
# Optional worker display name; defaults to hostname.
INFERNA_WORKER_NAME=
# Optional cluster to join; defaults to "default".
INFERNA_CLUSTER_NAME=default
# true = simulate engines in-process (no GPU, no docker) for demos/tests.
INFERNA_MOCK_ENGINE=false
# Host directory mounted into engine containers as the HF cache.
INFERNA_MODELS_DIR=./models
# Inference engine images (override to pin different tags).
INFERNA_VLLM_IMAGE=vllm/vllm-openai:v0.8.5
INFERNA_SGLANG_IMAGE=lmsysorg/sglang:v0.4.6.post1
# HuggingFace token passed to engine containers (required for gated models).
INFERNA_HF_TOKEN=
