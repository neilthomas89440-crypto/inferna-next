# Copy to .env and adjust. All variables use the INFERNA_ prefix.
# Loaded via pydantic-settings in server/inferna_server/config.py and
# worker/inferna_worker/config.py.

INFERNA_ENV=development
# development = permissive defaults; production = fail-fast if INFERNA_JWT_SECRET, INFERNA_ADMIN_PASSWORD or INFERNA_REGISTRATION_TOKEN are still the dev defaults.

# --- Server ---
# Database URL: SQLite (dev default) or PostgreSQL (docker compose).
INFERNA_DATABASE_URL=sqlite+aiosqlite:///./inferna.db
# JWT signing secret. Override in production (must not be "inferna-dev-secret" when INFERNA_ENV=production).
INFERNA_JWT_SECRET=inferna-dev-secret
# When false, every API call passes as an admin user (dev escape hatch).
INFERNA_AUTH_ENABLED=true
# Password of the seeded `admin` user (created on first startup). Must not be "inferna" in production.
INFERNA_ADMIN_PASSWORD=inferna
# Shared cluster token that workers must present to register. Must not be "inferna-registration-token" in production.
INFERNA_REGISTRATION_TOKEN=inferna-registration-token
# gRPC port for the worker registration/sync service.
INFERNA_GRPC_PORT=9091
# Comma-separated CORS allowed origins.
INFERNA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Host port pool allocated to model instances (per worker).
INFERNA_INSTANCE_PORT_RANGE_START=8010
INFERNA_INSTANCE_PORT_RANGE_END=8100
# Autoscaling (Release B). Disabled by default: the window must be set per deployment
# (PUT /api/v1/deployments/{id}/range) before anything moves.
INFERNA_AUTOSCALE_ENABLED=false
INFERNA_AUTOSCALE_INTERVAL_SECONDS=30
INFERNA_AUTOSCALE_COOLDOWN_SECONDS=300
INFERNA_AUTOSCALE_TARGET_TTFT_MS=1000
INFERNA_AUTOSCALE_TARGET_QUEUE=4
INFERNA_AUTOSCALE_SCALE_DOWN_RATIO=0.5

# Rendezvous ports for parallel groups (multi-node)
INFERNA_RENDEZVOUS_PORT_RANGE_START=8110
INFERNA_RENDEZVOUS_PORT_RANGE_END=8199
# Inference gateway upstream timeouts (seconds): connect, and read for non-streaming responses.
INFERNA_GATEWAY_CONNECT_TIMEOUT=5.0
INFERNA_GATEWAY_READ_TIMEOUT=300.0
# Kill-switch: false unmounts /v1/* entirely (mitigate an upstream CVE or abuse
# spike without a redeploy).
INFERNA_GATEWAY_ENABLED=true
# Ask OpenAI-compatible upstreams for a final usage chunk on streamed responses
# (stream_options.include_usage). Set false to forward request bodies verbatim; token
# accounting then degrades to request-only counting for streams.
INFERNA_GATEWAY_INJECT_STREAM_USAGE=true
# SSRF guard for worker-registered upstreams: comma-separated IPs, CIDRs, or
# hostnames. Empty = default policy (loopback/link-local/private rejected when
# INFERNA_ENV=production; development stays permissive). When set, ONLY
# allowlisted targets are reachable by the gateway.
INFERNA_GATEWAY_UPSTREAM_ALLOWLIST=
INFERNA_LOG_LEVEL=info
# --- Worker ---
# Control-plane gRPC endpoint (host:port).
INFERNA_SERVER_URL=localhost:9091
# Optional worker display name; defaults to hostname.
INFERNA_WORKER_NAME=
# Identity the server keys this worker by; override to run several workers on one host
INFERNA_WORKER_HOSTNAME=
# Multi-node: seconds a follower container must stay up before the rank is reported running
INFERNA_MN_RANK_READY_SECONDS=20
# NIC name NCCL uses for rank-to-rank traffic (multi-node containers use host networking)
INFERNA_WORKER_NETIF=eth0
# Optional cluster to join; defaults to "default".
INFERNA_CLUSTER_NAME=default
# true = simulate engines in-process (no GPU, no docker) for demos/tests.
INFERNA_MOCK_ENGINE=false
# Routable address for the inference gateway; empty = registered hostname.
# In docker compose the worker publishes host ports, so it registers host.docker.internal.
INFERNA_WORKER_ADDRESS=
# Host directory mounted into engine containers as the HF cache.
INFERNA_MODELS_DIR=./models
# Inference engine images (override to pin different tags).
INFERNA_VLLM_IMAGE=vllm/vllm-openai:v0.8.5
INFERNA_SGLANG_IMAGE=lmsysorg/sglang:v0.4.6.post1
# HuggingFace token passed to engine containers (required for gated models).
INFERNA_HF_TOKEN=
